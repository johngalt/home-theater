				<guid>//localhost:1313/posts/06---projects/house/basement/notes/links/</guid>
				<description>&lt;p&gt;Width: 13&amp;rsquo; 4&amp;quot;&lt;br&gt;&#xA;Depth: 17&amp;rsquo; 6&amp;quot;&lt;br&gt;&#xA;Height: 8&amp;rsquo; 7&amp;quot;&lt;/p&gt;&#xA;&lt;p&gt;&lt;a href=&#34;https://mytheaterbuild.com/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://mytheaterbuild.com/&lt;/a&gt;&lt;br&gt;&#xA;&lt;a href=&#34;https://pixelht.com/projector-calculator/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://pixelht.com/projector-calculator/&lt;/a&gt;&lt;br&gt;&#xA;&lt;a href=&#34;https://cinemaconfig.com/tools/speaker-layout&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://cinemaconfig.com/tools/speaker-layout&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Projector Brightness - &lt;a href=&#34;https://www.avsforum.com/threads/implementation-guide-for-the-cedia-cta-home-theater-video-design-bulletin-cta-cedia-ceb23-b.2944566/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/implementation-guide-for-the-cedia-cta-home-theater-video-design-bulletin-cta-cedia-ceb23-b.2944566/&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Speaker impedence - &lt;a href=&#34;https://www.youtube.com/watch?v=JaEgq7W8IZI&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.youtube.com/watch?v=JaEgq7W8IZI&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Timber matching - &lt;a href=&#34;https://www.youtube.com/watch?v=zuoz0wX1-2I&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.youtube.com/watch?v=zuoz0wX1-2I&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Soundproofing - &lt;a href=&#34;https://www.soundproofingcompany.com/soundproofing-solutions/soundproofing-walls&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.soundproofingcompany.com/soundproofing-solutions/soundproofing-walls&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;Ceiling backer boxes - &lt;a href=&#34;https://www.avsforum.com/threads/soundproofing-master-thread.1509173/page-42?post_id=54652188&amp;amp;nested_view=1#post-54652188&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/soundproofing-master-thread.1509173/page-42?post_id=54652188&amp;nested_view=1#post-54652188&lt;/a&gt;&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.avsforum.com/threads/ceiling-and-walls-with-resilient-channel.3254461/?post_id=61981931#post-61981931&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/ceiling-and-walls-with-resilient-channel.3254461/?post_id=61981931#post-61981931&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.reddit.com/r/hometheater/comments/pv63rm/diy_soundproof_ceiling_speaker_backing_boxes/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.reddit.com/r/hometheater/comments/pv63rm/diy_soundproof_ceiling_speaker_backing_boxes/&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;Ventilation and Sound Proofing - &lt;a href=&#34;https://www.soundproofingcompany.com/soundproofing_101/the-dead-vent&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.soundproofingcompany.com/soundproofing_101/the-dead-vent&lt;/a&gt;&lt;/p&gt;&#xA;&lt;p&gt;More soundproofing stuff - &lt;a href=&#34;https://www.avsforum.com/threads/soundproofing-does-not-exist.795585/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/soundproofing-does-not-exist.795585/&lt;/a&gt;&lt;/p&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;Take note of the clips used to secure the inner wall as well as clips for walls lining concrete&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.avsforum.com/threads/soundproofing-decouple-walls-with-brackets-or-clips-and-channel.1448832/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/soundproofing-decouple-walls-with-brackets-or-clips-and-channel.1448832/&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.avsforum.com/threads/basement-soundproofing-isolation-brackets-and-fire-blocking-solutions-short-circuiting-the-goal.3314600/?utm_source=google&amp;amp;utm_medium=organic&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/basement-soundproofing-isolation-brackets-and-fire-blocking-solutions-short-circuiting-the-goal.3314600/?utm_source=google&amp;utm_medium=organic&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.avsforum.com/threads/clip-or-dont-clip-the-need-of-a-dc04-is-the-question.1312727/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/clip-or-dont-clip-the-need-of-a-dc04-is-the-question.1312727/&lt;/a&gt;&lt;/li&gt;&#xA;&lt;li&gt;&lt;a href=&#34;https://www.avsforum.com/threads/scratching-my-head-about-decoupling-via-staggered-stud-construction-please-help.3170297/&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.avsforum.com/threads/scratching-my-head-about-decoupling-via-staggered-stud-construction-please-help.3170297/&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;p&gt;Home Theater Wall Secrets - &lt;a href=&#34;https://www.youtube.com/watch?v=Iv9NkHXUYq8&#34;  target=&#34;_blank&#34; rel=&#34;noreferrer nofollow&#34;&gt;https://www.youtube.com/watch?v=Iv9NkHXUYq8&lt;/a&gt;&lt;/p&gt;</description>
